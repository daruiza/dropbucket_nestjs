generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Puedes añadir esto para bases de datos que lo soporten y Prisma lo tenga configurado
  // relationMode = "prisma" // Para ciertos casos de escalabilidad
  // connect_timeout_in_seconds = 20 // Para ajustar el tiempo de espera
  // pool_timeout = 10 // Tiempo máximo en segundos para obtener una conexión del pool
  // max_connections = 10 // Número máximo de conexiones en el pool
}

model Rol {
  id    Int     @default(autoincrement()) @id
  name        String?  
  description String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users User[]
  optionrols OptionRol[]
}

model Option {
  id    Int     @default(autoincrement()) @id
  name        String?  
  description String?  
  optionrols OptionRol[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OptionRol {
  id    Int     @default(autoincrement()) @id  
  rol       Rol? @relation(fields: [rolId], references: [id])
  rolId    Int?
  option       Option? @relation(fields: [optionId], references: [id])
  optionId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @default(autoincrement()) @id
  email     String @unique
  name      String @unique
  names     String?
  lastnames  String?
  phone     String?
  theme     String?
  prefix     String?
  photo     String?
  password  String
  rol       Rol? @relation(fields: [rolId], references: [id])
  rolId    Int? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}