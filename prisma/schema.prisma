generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id    Int     @default(autoincrement()) @id
  name        String?  
  description String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users User[]
  optionrols OptionRol[]
}

model Option {
  id    Int     @default(autoincrement()) @id
  name        String?  
  description String?  
  optionrols OptionRol[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OptionRol {
  id    Int     @default(autoincrement()) @id  
  rol       Rol? @relation(fields: [rolId], references: [id])
  rolId    Int?
  option       Option? @relation(fields: [optionId], references: [id])
  optionId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @default(autoincrement()) @id
  email     String @unique
  name      String @unique
  names     String?
  lastnames  String?
  phone     String?
  theme     String?
  prefix     String?
  photo     String?
  password  String
  rol       Rol? @relation(fields: [rolId], references: [id])
  rolId    Int? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}